---
const year = new Date().getFullYear();
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const madeWith = lang === 'es' ? 'Hecho con Astro' : 'Built with Astro';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <span class="footer-logo">OACH</span>
    <span class="footer-copy">© {year} · OACH · {madeWith}</span>
    <div class="footer-links">
      <a href="https://github.com/OACH-py" class="footer-link" target="_blank" rel="noopener">GitHub</a>
      <a href="https://youtube.com/@ZentoPath" class="footer-link" target="_blank" rel="noopener">ZentoPath</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--sp-20);
    padding: var(--sp-8) 0;
    border-top: 1px solid rgba(203, 166, 247, 0.07);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }

  .footer-logo {
    font-weight: 800;
    font-size: 1rem;
    color: var(--mauve);
    opacity: 0.6;
  }

  .footer-copy {
    font-size: 0.78rem;
    color: var(--overlay0);
  }

  .footer-links { display: flex; gap: var(--sp-4); }

  .footer-link {
    font-size: 0.78rem;
    color: var(--overlay0);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-link:hover { color: var(--mauve); }
</style>
