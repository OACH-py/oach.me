---
import ProjectCard from './ProjectCard.astro';
import { softwareProjectsEs, softwareProjectsEn, softwareProjectsRu } from '../data/projects';
import { fetchLangTags, fetchRepoStats, STATIC_TAGS } from '../lib/github';
import { fetchYouTubeData, fmtNum } from '../lib/youtube';
import { homeT } from '../i18n/home';

interface Props {
  lang: 'es' | 'en' | 'ru';
}

const { lang } = Astro.props;

const projectsMap = { es: softwareProjectsEs, en: softwareProjectsEn, ru: softwareProjectsRu };
const projects = projectsMap[lang];
const [zentopath, kansoBase, oachmeBase, mediaServer, pythonBase] = projects;

const [kansoLangs, oachLangs, pythonLangs, kansoStats, oachStats, mediaStats, pythonStats] = await Promise.all([
  fetchLangTags(kansoBase.githubRepo!),
  fetchLangTags(oachmeBase.githubRepo!),
  fetchLangTags(pythonBase.githubRepo!),
  fetchRepoStats(kansoBase.githubRepo!),
  fetchRepoStats(oachmeBase.githubRepo!),
  fetchRepoStats(mediaServer.githubRepo!),
  fetchRepoStats(pythonBase.githubRepo!),
]);

const kanso  = { ...kansoBase,  tags: [...kansoLangs,  ...STATIC_TAGS], stars: kansoStats?.stars  ?? 0 };
const oachme = { ...oachmeBase, tags: [...oachLangs,   ...STATIC_TAGS], stars: oachStats?.stars   ?? 0 };
const media  = { ...mediaServer,                                          stars: mediaStats?.stars  ?? 0 };
const python = { ...pythonBase, tags: [...pythonLangs, ...STATIC_TAGS], stars: pythonStats?.stars ?? 0 };

const yt = await fetchYouTubeData();
const ytMaxViews = yt?.videos.length
  ? Math.max(...yt.videos.map(v => v.views))
  : 1;

const tx = homeT[lang];
---

<!-- HERO -->
<section id="hero" class="hero" aria-label={tx.ariaHero}>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-inner">

    <div class="hero-term" aria-hidden="true">
      <span class="p-user">oach</span><span class="p-at">@</span><span class="p-host">zen</span><span class="p-colon">:</span><span class="p-tilde">~</span><span class="p-dollar">$</span><span class="hero-term-cmd"> cat about.md</span><span class="hero-term-cursor">▋</span>
    </div>
    <h1 class="hero-title shimmer-text">OACH</h1>
    <p class="hero-sub">{tx.heroParagraph}</p>

    <nav class="hero-actions" aria-label={tx.ariaActions}>
      <a href="#zento" class="btn btn-primary">{tx.heroBtn}</a>
      <a href="https://github.com/OACH-py" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href="mailto:contact@oach.me" class="btn btn-ghost">{tx.contactBtn}</a>
    </nav>

  </div>
</section>

<!-- PROJECTS -->
<section id="zento" class="section container" aria-labelledby="projects-heading">

  <span class="section-label" id="projects-heading" data-reveal>{tx.sec01}</span>

  <div class="bento-grid">

    <!-- ZentoPath — celda grande, 2 columnas -->
    <div class="glass glass-featured tilt-card featured-card bento-featured" data-reveal style="--reveal-delay: 0.05s">

      <div class="feat-header">
        <div>
          <span class="feat-eyebrow">{tx.flagship}</span>
          <h2 class="feat-title grad-text-hero">ZentoPath</h2>
          <p class="feat-meta">{tx.featMeta}</p>
        </div>
        <a href="https://youtube.com/@ZentoPath" class="btn btn-primary feat-cta" target="_blank" rel="noopener noreferrer">
          {tx.viewChan}
        </a>
      </div>

      <p class="feat-desc">{zentopath.description}</p>

      <div class="tags" aria-label={tx.ariaTech}>
        {zentopath.tags.map(t => <span class="tag tag-sapphire">{t}</span>)}
      </div>

      {yt && (
        <>
          <!-- Stats del canal -->
          <div class="yt-stats">
            <div class="yt-stat">
              <span class="yt-stat-num">{fmtNum(yt.stats.subscribers)}</span>
              <span class="yt-stat-label">{tx.ytSubscribers}</span>
            </div>
            <div class="yt-stat-sep" aria-hidden="true"></div>
            <div class="yt-stat">
              <span class="yt-stat-num">{fmtNum(yt.stats.totalViews)}</span>
              <span class="yt-stat-label">{tx.ytViews}</span>
            </div>
            <div class="yt-stat-sep" aria-hidden="true"></div>
            <div class="yt-stat">
              <span class="yt-stat-num">{yt.stats.videoCount}</span>
              <span class="yt-stat-label">{tx.ytVideos}</span>
            </div>
          </div>

          <!-- Últimos 3 videos / estado vacío -->
          <div class="yt-section">
            <span class="yt-section-label">{tx.ytRecent}</span>
            {yt.videos.length > 0 ? (
              <div class="yt-videos">
                {yt.videos.map(video => (
                  <a href={video.url} class="yt-video-card" target="_blank" rel="noopener noreferrer">
                    <div class="yt-thumb-wrap">
                      <img
                        src={video.thumbnail}
                        alt=""
                        aria-hidden="true"
                        class="yt-thumb"
                        width="480"
                        height="270"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="yt-play" aria-hidden="true">▶</span>
                    </div>
                    <div class="yt-video-info">
                      <p class="yt-video-title">{video.title}</p>
                      <div class="yt-bar-wrap" aria-hidden="true">
                        <div
                          class="yt-bar"
                          style={`width: ${Math.round((video.views / ytMaxViews) * 100)}%`}
                        ></div>
                      </div>
                      <span class="yt-video-views">{fmtNum(video.views)} {tx.ytViews}</span>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <p class="yt-early">{tx.ytEarly}</p>
            )}
          </div>
        </>
      )}

    </div>

    <!-- Kansō — columna derecha -->
    <div class="bento-slot" data-reveal style="--reveal-delay: 0.10s">
      <ProjectCard project={kanso} lang={lang} />
    </div>

    <!-- Media Server — fila 2, col 1 -->
    <div class="bento-slot" data-reveal style="--reveal-delay: 0.15s">
      <ProjectCard project={media} lang={lang} />
    </div>

    <!-- oach.me — fila 2, col 2 -->
    <div class="bento-slot" data-reveal style="--reveal-delay: 0.20s">
      <ProjectCard project={oachme} lang={lang} />
    </div>

    <!-- Python Fundamentals — fila 2, col 3 -->
    <div class="bento-slot" data-reveal style="--reveal-delay: 0.25s">
      <ProjectCard project={python} lang={lang} />
    </div>

  </div>

</section>

<hr class="divider container" />

<!-- ENGINEERING -->
<section id="notes" class="section container" aria-labelledby="eng-heading">

  <span class="section-label" id="eng-heading" data-reveal>{tx.sec02}</span>

  <div class="eng-grid">

    <!-- Tarjeta narrativa -->
    <div class="glass tilt-card eng-card" data-reveal style="--reveal-delay: 0.06s">
      <h2 class="eng-title grad-text-hero">{tx.engTitle}</h2>
      <p class="eng-desc">{tx.engP1}</p>
      <p class="eng-desc">
        {tx.engP2}
        <strong class="accent-teal">{tx.engSpec}</strong>{tx.engP2tail}
      </p>
    </div>

    <!-- Tarjeta de competencias -->
    <div class="glass tilt-card eng-skills-card" data-reveal style="--reveal-delay: 0.12s">

      <span class="eng-stack-label">{tx.skillsTitle}</span>

      <div class="skills-grid">

        <div class="eng-stack-group">
          <span class="eng-stack-label">{tx.skillsLangGroup}</span>
          <div class="tags">
            <span class="tag tag-sapphire">🐍 Python</span>
            <span class="tag tag-peach">🦀 Rust</span>
            <span class="tag tag-teal">🔷 TypeScript</span>
            <span class="tag tag-neutral">Bash / Shell</span>
          </div>
        </div>

        <div class="eng-stack-group">
          <span class="eng-stack-label">{tx.skillsInfraGroup}</span>
          <div class="tags">
            <span class="tag tag-mauve">Arch Linux</span>
            <span class="tag tag-teal">🐳 Docker</span>
            <span class="tag tag-neutral">Docker Compose</span>
            <span class="tag tag-neutral">Self-hosting</span>
            <span class="tag tag-neutral">Git</span>
            <span class="tag tag-neutral">Zed · VS Code</span>
          </div>
        </div>

        <div class="eng-stack-group">
          <span class="eng-stack-label">{tx.skillsWebGroup}</span>
          <div class="tags">
            <span class="tag tag-mauve">TUI</span>
            <span class="tag tag-teal">Astro / SSG</span>
            <span class="tag tag-sapphire">REST APIs</span>
            <span class="tag tag-neutral">Web Scraping</span>
            <span class="tag tag-mauve">{tx.skillWebAI}</span>
          </div>
        </div>

        <div class="eng-stack-group">
          <span class="eng-stack-label">{tx.skillsHwGroup}</span>
          <div class="tags">
            <span class="tag tag-peach">{tx.skillHwCircuits}</span>
            <span class="tag tag-neutral">{tx.skillHwDigital}</span>
            <span class="tag tag-teal">{tx.engSpec}</span>
            <span class="tag tag-sapphire">{tx.skillHwEmbedded}</span>
            <span class="tag tag-peach">PCB Design</span>
          </div>
        </div>

      </div>

    </div>

  </div>

</section>

<hr class="divider container" />

<!-- PHILOSOPHY -->
<section id="filosofia" class="section container" aria-labelledby="philo-heading">

  <span class="section-label" id="philo-heading" data-reveal>{tx.sec03}</span>

  <p class="section-intro" data-reveal style="--reveal-delay: 0.06s">
    {tx.philoIntro}
    <strong class="accent-mauve">Suckless</strong> {tx.philoAnd}
    <strong class="accent-sapphire">Arch Linux</strong>
    {' '}{tx.philoTailA}
  </p>
  <p class="section-intro" data-reveal style="--reveal-delay: 0.10s">
    {tx.philoTailB}
  </p>

  <div class="axioms-grid">
    {tx.axioms.map((a, i) => (
      <article class="glass tilt-card axiom-card" data-reveal style={`--reveal-delay: ${0.05 + i * 0.07}s`}>
        <div class="axiom-head">
          <span class="axiom-num" aria-hidden="true">{a.num}</span>
          <h3 class={`axiom-title axiom-${a.color}`} set:html={a.title} />
        </div>
        <p class="axiom-label">{a.label}</p>
        <p class="axiom-desc" set:html={a.desc} />
      </article>
    ))}
  </div>

</section>

<hr class="divider container" />

<!-- CONTACT -->
<section id="contact" class="section container" aria-labelledby="contact-heading">

  <span class="section-label" id="contact-heading" data-reveal>{tx.sec04}</span>

  <div class="glass tilt-card contact-card" data-reveal style="--reveal-delay: 0.05s">
    <h2 class="contact-title grad-text-hero">{tx.contactTitle}</h2>
    <p class="contact-desc">{tx.contactDesc}</p>
    <div class="contact-links">
      <a href="mailto:contact@oach.me" class="contact-pill">contact@oach.me</a>
      <a href="https://github.com/OACH-py" class="contact-pill" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </div>

</section>

<style>
  /* ── Hero terminal prompt ─────────────────────────────────────────── */
  .hero-term {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0.50;
    user-select: none;
  }

  .p-user   { color: var(--mauve); }
  .p-at     { color: var(--subtext0); }
  .p-host   { color: var(--teal); }
  .p-colon  { color: var(--subtext0); }
  .p-tilde  { color: var(--blue); }
  .p-dollar { color: var(--green); }

  .hero-term-cmd    { color: var(--subtext0); }
  .hero-term-cursor { color: var(--mauve); }

  @media (prefers-reduced-motion: no-preference) {
    .hero-term-cursor { animation: cursor-blink 1.1s step-start infinite; }
  }

  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding: var(--sp-24) 0 var(--sp-20);
    overflow: hidden;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -62%);
    width: 1000px; height: 700px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      rgba(203, 166, 247, 0.22) 0%,
      rgba(245, 194, 231, 0.10) 28%,
      rgba(242, 205, 205, 0.07) 45%,
      rgba(116, 199, 236, 0.07) 58%,
      transparent 72%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
  }

  .hero-title {
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 9rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .hero-sub {
    font-size: clamp(0.78rem, 2vw, 0.88rem);
    color: var(--overlay1);
    letter-spacing: 0.05em;
  }

  .hero-actions {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--sp-2);
  }

  /* ── Section labels ───────────────────────────────────────────────── */
  .section-label {
    display: block;
    font-size: 0.73rem;
    color: var(--overlay1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--sp-6);
  }

  .section-intro {
    font-size: 0.95rem;
    color: var(--text);
    opacity: 0.82;
    line-height: 1.75;
    max-width: 680px;
    margin-bottom: var(--sp-8);
  }

  /* ── Bento grid ───────────────────────────────────────────────────── */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }

  .bento-featured { grid-column: 1 / 3; }

  .bento-slot {
    display: flex;
    flex-direction: column;
  }

  .bento-slot :global(.project-card) {
    flex: 1;
  }

  /* ── ZentoPath featured card ──────────────────────────────────────── */
  .featured-card {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .feat-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .feat-eyebrow {
    display: block;
    font-size: 0.7rem;
    color: var(--overlay1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--sp-2);
  }

  .feat-title {
    font-weight: 800;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    letter-spacing: -0.03em;
  }

  .feat-meta {
    font-size: 0.76rem;
    color: var(--overlay1);
    margin-top: var(--sp-1);
  }

  .feat-cta { align-self: flex-start; }

  .feat-desc {
    font-size: 0.93rem;
    line-height: 1.78;
    color: var(--text);
    opacity: 0.86;
  }

  /* ── YouTube stats ───────────────────────────────────────────────── */
  .yt-stats {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4) 0;
    border-top: 1px solid rgba(203, 166, 247, 0.10);
    border-bottom: 1px solid rgba(203, 166, 247, 0.10);
    flex-wrap: wrap;
  }

  .yt-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .yt-stat-num {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--sapphire);
    letter-spacing: -0.02em;
  }

  .yt-stat-label {
    font-size: 0.68rem;
    color: var(--overlay2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .yt-stat-sep {
    width: 1px;
    height: 2rem;
    background: rgba(203, 166, 247, 0.15);
    flex-shrink: 0;
  }

  /* ── YouTube recent videos ────────────────────────────────────────── */
  .yt-section {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .yt-section-label {
    font-size: 0.68rem;
    color: var(--overlay1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .yt-videos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-3);
  }

  .yt-video-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    text-decoration: none;
    border-radius: 10px;
    overflow: hidden;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .yt-video-card:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  .yt-thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    background: var(--mantle);
  }

  .yt-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .yt-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: white;
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .yt-video-card:hover .yt-play { opacity: 1; }

  .yt-video-info {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: 0 var(--sp-1);
  }

  .yt-video-title {
    font-size: 0.75rem;
    color: var(--text);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .yt-bar-wrap {
    height: 3px;
    background: rgba(116, 199, 236, 0.15);
    border-radius: 99px;
    overflow: hidden;
  }

  .yt-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--sapphire), var(--teal));
    border-radius: 99px;
    min-width: 4px;
  }

  .yt-video-views {
    font-size: 0.67rem;
    color: var(--overlay2);
  }

  .yt-early {
    font-size: 0.82rem;
    color: var(--overlay1);
    font-style: italic;
    opacity: 0.75;
  }

  @media (max-width: 560px) {
    .yt-videos { grid-template-columns: 1fr; }
    .yt-stat-sep { display: none; }
  }

  /* ── Engineering layout ──────────────────────────────────────────── */
  .eng-grid {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .eng-card {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .eng-title {
    font-weight: 800;
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    letter-spacing: -0.03em;
  }

  .eng-desc {
    font-size: 0.92rem;
    line-height: 1.85;
    color: var(--text);
    opacity: 0.82;
  }

  .eng-stack-group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .eng-stack-label {
    font-size: 0.68rem;
    color: var(--overlay1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ── Engineering skills card ─────────────────────────────────────── */
  .eng-skills-card {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-6);
  }

  @media (max-width: 860px) {
    .skills-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .skills-grid { grid-template-columns: 1fr; }
  }

  /* ── Axioms grid — mobile-first ───────────────────────────────────── */
  .axioms-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
  }

  @media (min-width: 640px) {
    .axioms-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .axiom-card {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .axiom-head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .axiom-num {
    font-size: 0.7rem;
    color: var(--overlay2);
    letter-spacing: 0.12em;
  }

  .axiom-title {
    font-weight: 800;
    font-size: clamp(1.2rem, 3vw, 1.45rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .axiom-mauve    { color: var(--mauve); }
  .axiom-sapphire { color: var(--sapphire); }
  .axiom-teal     { color: var(--teal); }
  .axiom-peach    { color: var(--peach); }

  .axiom-label {
    font-size: 0.73rem;
    color: var(--overlay2);
    letter-spacing: 0.05em;
  }

  .axiom-desc {
    font-size: 0.9rem;
    color: var(--text);
    opacity: 0.82;
    line-height: 1.72;
  }

  .axiom-desc :global(em) {
    font-style: normal;
    color: var(--text);
    opacity: 1;
  }

  /* ── Bento responsive ────────────────────────────────────────────── */
  @media (max-width: 860px) {
    .bento-grid             { grid-template-columns: repeat(2, 1fr); }
    .bento-featured         { grid-column: 1 / 3; }
  }

  @media (max-width: 560px) {
    .bento-grid             { grid-template-columns: 1fr; }
    .bento-featured         { grid-column: 1; }
  }

  /* ── Mobile overrides ─────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero            { padding: var(--sp-16) 0; }
    .featured-card   { padding: var(--sp-6); }
    .eng-card        { padding: var(--sp-6); }
    .eng-skills-card { padding: var(--sp-6); }
    .hero-title      { letter-spacing: -0.04em; }
    .axiom-card      { padding: var(--sp-6); }
  }

  @media (max-width: 480px) {
    .featured-card,
    .eng-card   { padding: var(--sp-6) var(--sp-4); }
    .axiom-card { padding: var(--sp-4); }
    .feat-desc,
    .eng-desc   { font-size: 0.9rem; }
    .section-intro { font-size: 0.88rem; }
