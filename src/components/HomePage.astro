---
import ProjectCard from './ProjectCard.astro';
import { softwareProjectsEs, softwareProjectsEn, softwareProjectsRu } from '../data/projects';
import { fetchLangTags, STATIC_TAGS } from '../lib/github';
import { homeT } from '../i18n/home';

interface Props {
  lang: 'es' | 'en' | 'ru';
}

const { lang } = Astro.props;

const projectsMap = { es: softwareProjectsEs, en: softwareProjectsEn, ru: softwareProjectsRu };
const projects = projectsMap[lang];
const [zentopath, kansoBase, oachmeBase] = projects;

const [kansoLangs, oachLangs] = await Promise.all([
  fetchLangTags(kansoBase.githubRepo!),
  fetchLangTags(oachmeBase.githubRepo!),
]);

const kanso  = { ...kansoBase,  tags: [...kansoLangs,  ...STATIC_TAGS] };
const oachme = { ...oachmeBase, tags: [...oachLangs,   ...STATIC_TAGS] };

const tx = homeT[lang];
---

<!-- HERO -->
<section id="hero" class="hero" aria-label="Hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-inner">

    <h1 class="hero-title shimmer-text">OACH</h1>
    <p class="hero-sub">{tx.heroParagraph}</p>

    <nav class="hero-actions" aria-label="Acciones rápidas">
      <a href="#zento" class="btn btn-primary">{tx.heroBtn}</a>
      <a href="https://github.com/OACH-py" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href="https://youtube.com/@ZentoPath" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">ZentoPath ↗</a>
    </nav>

  </div>
</section>

<!-- PROJECTS -->
<section id="zento" class="section container" aria-labelledby="projects-heading">

  <span class="section-label" id="projects-heading" data-reveal>{tx.sec01}</span>

  <div class="glass glass-featured tilt-card featured-card" data-reveal style="--reveal-delay: 0.05s">
    <div class="feat-header">
      <div class="feat-identity">
        <div>
          <span class="feat-eyebrow">{tx.flagship}</span>
          <h2 class="feat-title grad-text-hero">ZentoPath</h2>
          <p class="feat-meta">{tx.featMeta}</p>
        </div>
      </div>
      <a href="https://youtube.com/@ZentoPath" class="btn btn-primary feat-cta" target="_blank" rel="noopener noreferrer">
        {tx.viewChan}
      </a>
    </div>

    <p class="feat-desc">{zentopath.description}</p>

    <div class="tags" aria-label="Tecnologías">
      {zentopath.tags.map(t => <span class="tag tag-sapphire">{t}</span>)}
    </div>
  </div>

  <div class="project-row" data-reveal style="--reveal-delay: 0.12s">
    <ProjectCard project={kanso}  lang={lang} />
    <ProjectCard project={oachme} lang={lang} />
  </div>

</section>

<hr class="divider container" />

<!-- ENGINEERING -->
<section id="notes" class="section container" aria-labelledby="eng-heading">

  <span class="section-label" id="eng-heading" data-reveal>{tx.sec02}</span>

  <div class="glass tilt-card eng-card" data-reveal style="--reveal-delay: 0.08s">
    <h2 class="eng-title grad-text-hero">{tx.engTitle}</h2>
    <p class="eng-desc">{tx.engP1}</p>
    <p class="eng-desc">
      {tx.engP2}
      <strong class="accent-teal">{tx.engSpec}</strong>{tx.engP2tail}
    </p>
  </div>

</section>

<hr class="divider container" />

<!-- PHILOSOPHY -->
<section id="filosofia" class="section container" aria-labelledby="philo-heading">

  <span class="section-label" id="philo-heading" data-reveal>{tx.sec03}</span>

  <p class="section-intro" data-reveal style="--reveal-delay: 0.06s">
    {tx.philoIntro}
    <strong class="accent-mauve">Suckless</strong> {tx.philoAnd}
    <strong class="accent-sapphire">Arch Linux</strong>
    {' '}{tx.philoTail}
  </p>

  <div class="axioms-grid">
    {tx.axioms.map((a, i) => (
      <article class="glass tilt-card axiom-card" data-reveal style={`--reveal-delay: ${0.05 + i * 0.07}s`}>
        <div class="axiom-head">
          <span class="axiom-num" aria-hidden="true">{a.num}</span>
          <h3 class={`axiom-title axiom-${a.color}`} set:html={a.title} />
        </div>
        <p class="axiom-label">{a.label}</p>
        <p class="axiom-desc" set:html={a.desc} />
      </article>
    ))}
  </div>

</section>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding: var(--sp-24) 0 var(--sp-20);
    overflow: hidden;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -62%);
    width: 1000px; height: 700px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      rgba(203, 166, 247, 0.22) 0%,
      rgba(245, 194, 231, 0.10) 28%,
      rgba(242, 205, 205, 0.07) 45%,
      rgba(116, 199, 236, 0.07) 58%,
      transparent 72%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
  }

  .hero-title {
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 9rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .hero-sub {
    font-size: clamp(0.78rem, 2vw, 0.88rem);
    color: var(--overlay1);
    letter-spacing: 0.05em;
  }

  .hero-actions {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--sp-2);
  }

  /* ── Section labels ───────────────────────────────────────────────── */
  .section-label {
    display: block;
    font-size: 0.73rem;
    color: var(--overlay1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--sp-6);
  }

  .section-intro {
    font-size: 0.95rem;
    color: var(--text);
    opacity: 0.82;
    line-height: 1.75;
    max-width: 680px;
    margin-bottom: var(--sp-8);
  }

  /* ── ZentoPath featured card ──────────────────────────────────────── */
  .featured-card {
    padding: var(--sp-10);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .feat-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-6);
    flex-wrap: wrap;
  }

  .feat-identity {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
  }

  .feat-eyebrow {
    display: block;
    font-size: 0.70rem;
    color: var(--overlay1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--sp-2);
  }

  .feat-title {
    font-weight: 800;
    font-size: clamp(1.8rem, 5vw, 3.2rem);
    letter-spacing: -0.03em;
  }

  .feat-meta {
    font-size: 0.76rem;
    color: var(--overlay1);
    margin-top: var(--sp-1);
  }

  .feat-cta { align-self: flex-start; }

  .feat-desc {
    font-size: 0.97rem;
    line-height: 1.78;
    color: var(--text);
    opacity: 0.86;
    max-width: 700px;
  }

  /* ── Project row ──────────────────────────────────────────────────── */
  .project-row {
    margin-top: var(--sp-6);
    display: grid;
    /* min() prevents overflow on narrow viewports */
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: var(--sp-6);
  }

  /* ── Engineering card ─────────────────────────────────────────────── */
  .eng-card {
    padding: var(--sp-10);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .eng-title {
    font-weight: 800;
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    letter-spacing: -0.03em;
  }

  .eng-desc {
    font-size: 0.95rem;
    line-height: 1.78;
    color: var(--text);
    opacity: 0.82;
    max-width: 700px;
  }

  /* ── Axioms grid — mobile-first ───────────────────────────────────── */
  .axioms-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
  }

  @media (min-width: 640px) {
    .axioms-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .axiom-card {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .axiom-head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .axiom-num {
    font-size: 0.70rem;
    color: var(--overlay0);
    letter-spacing: 0.12em;
  }

  .axiom-title {
    font-weight: 800;
    font-size: clamp(1.2rem, 3vw, 1.45rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .axiom-mauve    { color: var(--mauve); }
  .axiom-sapphire { color: var(--sapphire); }
  .axiom-teal     { color: var(--teal); }
  .axiom-peach    { color: var(--peach); }

  .axiom-label {
    font-size: 0.73rem;
    color: var(--overlay0);
    letter-spacing: 0.05em;
  }

  .axiom-desc {
    font-size: 0.9rem;
    color: var(--text);
    opacity: 0.82;
    line-height: 1.72;
  }

  .axiom-desc :global(em) {
    font-style: normal;
    color: var(--text);
    opacity: 1;
  }

  /* ── Mobile overrides ─────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero          { padding: var(--sp-16) 0; }
    .featured-card { padding: var(--sp-6); }
    .eng-card      { padding: var(--sp-6); }
    .hero-title    { letter-spacing: -0.04em; }
    .axiom-card    { padding: var(--sp-6); }
  }

  /* Pantallas estrechas: asimetría vertical/horizontal en tarjetas
     para maximizar el área de texto sin tocar los bordes.           */
  @media (max-width: 480px) {
    .featured-card,
    .eng-card   { padding: var(--sp-6) var(--sp-4); }
    .axiom-card { padding: var(--sp-4); }
    .feat-desc,
    .eng-desc   { font-size: 0.9rem; }
    .section-intro { font-size: 0.88rem; }
  }

  @media (max-width: 400px) {
    .hero         { padding: var(--sp-12) 0; }
    .hero-actions { flex-direction: column; align-items: center; }
    .hero-sub     { font-size: 0.75rem; }
  }
</style>
