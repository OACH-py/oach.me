---
import ProjectCard from './ProjectCard.astro';
import { softwareProjectsEs, softwareProjectsEn, softwareProjectsRu } from '../data/projects';
import { fetchLangTags, STATIC_TAGS } from '../lib/github';
import { homeT } from '../i18n/home';

interface Props {
  lang: 'es' | 'en' | 'ru';
}

const { lang } = Astro.props;

const projectsMap = { es: softwareProjectsEs, en: softwareProjectsEn, ru: softwareProjectsRu };
const projects = projectsMap[lang];
const [zentopath, kansoBase, oachmeBase, mediaServer] = projects;

const [kansoLangs, oachLangs] = await Promise.all([
  fetchLangTags(kansoBase.githubRepo!),
  fetchLangTags(oachmeBase.githubRepo!),
]);

const kanso  = { ...kansoBase,  tags: [...kansoLangs,  ...STATIC_TAGS] };
const oachme = { ...oachmeBase, tags: [...oachLangs,   ...STATIC_TAGS] };

const tx = homeT[lang];
---

<!-- HERO -->
<section id="hero" class="hero" aria-label="Hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-inner">

    <h1 class="hero-title shimmer-text">OACH</h1>
    <p class="hero-sub">{tx.heroParagraph}</p>

    <nav class="hero-actions" aria-label="Acciones rápidas">
      <a href="#zento" class="btn btn-primary">{tx.heroBtn}</a>
      <a href="https://github.com/OACH-py" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href="mailto:contact@oach.me" class="btn btn-ghost">{tx.contactBtn}</a>
    </nav>

  </div>
</section>

<!-- PROJECTS -->
<section id="zento" class="section container" aria-labelledby="projects-heading">

  <span class="section-label" id="projects-heading" data-reveal>{tx.sec01}</span>

  <div class="bento-grid">

    <!-- ZentoPath — celda grande, 2 columnas -->
    <div class="glass glass-featured tilt-card featured-card bento-featured" data-reveal style="--reveal-delay: 0.05s">
      <div class="feat-header">
        <div>
          <span class="feat-eyebrow">{tx.flagship}</span>
          <h2 class="feat-title grad-text-hero">ZentoPath</h2>
          <p class="feat-meta">{tx.featMeta}</p>
        </div>
        <a href="https://youtube.com/@ZentoPath" class="btn btn-primary feat-cta" target="_blank" rel="noopener noreferrer">
          {tx.viewChan}
        </a>
      </div>
      <p class="feat-desc">{zentopath.description}</p>
      <div class="tags" aria-label="Tecnologías">
        {zentopath.tags.map(t => <span class="tag tag-sapphire">{t}</span>)}
      </div>
    </div>

    <!-- Kansō — columna derecha, abarca 2 filas -->
    <div class="bento-slot bento-tall" data-reveal style="--reveal-delay: 0.10s">
      <ProjectCard project={kanso} lang={lang} />
    </div>

    <!-- Media Server — fila 2, col 1 -->
    <div class="bento-slot" data-reveal style="--reveal-delay: 0.15s">
      <ProjectCard project={mediaServer} lang={lang} />
    </div>

    <!-- oach.me — fila 2, col 2 -->
    <div class="bento-slot" data-reveal style="--reveal-delay: 0.20s">
      <ProjectCard project={oachme} lang={lang} />
    </div>

  </div>

</section>

<hr class="divider container" />

<!-- ENGINEERING -->
<section id="notes" class="section container" aria-labelledby="eng-heading">

  <span class="section-label" id="eng-heading" data-reveal>{tx.sec02}</span>

  <div class="eng-grid">

    <!-- Tarjeta narrativa -->
    <div class="glass tilt-card eng-card" data-reveal style="--reveal-delay: 0.06s">
      <h2 class="eng-title grad-text-hero">{tx.engTitle}</h2>
      <p class="eng-desc">{tx.engP1}</p>
      <p class="eng-desc">
        {tx.engP2}
        <strong class="accent-teal">{tx.engSpec}</strong>{tx.engP2tail}
      </p>
    </div>

    <!-- Tarjeta de stack -->
    <div class="glass tilt-card eng-stack-card" data-reveal style="--reveal-delay: 0.12s">

      <div class="eng-stack-group">
        <span class="eng-stack-label">{tx.stackLabel}</span>
        <div class="tags">
          <span class="tag tag-mauve">Arch Linux</span>
          <span class="tag tag-peach">🦀 Rust</span>
          <span class="tag tag-sapphire">🐍 Python</span>
          <span class="tag tag-teal">🐳 Docker</span>
          <span class="tag tag-neutral">Zed</span>
          <span class="tag tag-neutral">VS Code</span>
        </div>
      </div>

      <div class="eng-stack-group">
        <span class="eng-stack-label">{tx.exploringLabel}</span>
        <div class="tags">
          <span class="tag tag-peach">PCB Design</span>
          <span class="tag tag-mauve">IA / Agentes</span>
        </div>
      </div>

      <div class="eng-stack-group">
        <span class="eng-stack-label">{tx.focusLabel}</span>
        <div class="tags">
          <span class="tag tag-teal">Control & Automatización</span>
          <span class="tag tag-sapphire">Sistemas Embebidos</span>
        </div>
      </div>

    </div>

  </div>

</section>

<hr class="divider container" />

<!-- PHILOSOPHY -->
<section id="filosofia" class="section container" aria-labelledby="philo-heading">

  <span class="section-label" id="philo-heading" data-reveal>{tx.sec03}</span>

  <p class="section-intro" data-reveal style="--reveal-delay: 0.06s">
    {tx.philoIntro}
    <strong class="accent-mauve">Suckless</strong> {tx.philoAnd}
    <strong class="accent-sapphire">Arch Linux</strong>
    {' '}{tx.philoTail}
  </p>

  <div class="axioms-grid">
    {tx.axioms.map((a, i) => (
      <article class="glass tilt-card axiom-card" data-reveal style={`--reveal-delay: ${0.05 + i * 0.07}s`}>
        <div class="axiom-head">
          <span class="axiom-num" aria-hidden="true">{a.num}</span>
          <h3 class={`axiom-title axiom-${a.color}`} set:html={a.title} />
        </div>
        <p class="axiom-label">{a.label}</p>
        <p class="axiom-desc" set:html={a.desc} />
      </article>
    ))}
  </div>

</section>

<hr class="divider container" />

<!-- CONTACT -->
<section id="contact" class="section container" aria-labelledby="contact-heading">

  <span class="section-label" id="contact-heading" data-reveal>{tx.sec04}</span>

  <div class="glass tilt-card contact-card" data-reveal style="--reveal-delay: 0.05s">
    <h2 class="contact-title grad-text-hero">{tx.contactTitle}</h2>
    <p class="contact-desc">{tx.contactDesc}</p>
    <div class="contact-links">
      <a href="mailto:contact@oach.me" class="contact-pill">contact@oach.me</a>
      <a href="https://github.com/OACH-py" class="contact-pill" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </div>

</section>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding: var(--sp-24) 0 var(--sp-20);
    overflow: hidden;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -62%);
    width: 1000px; height: 700px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      rgba(203, 166, 247, 0.22) 0%,
      rgba(245, 194, 231, 0.10) 28%,
      rgba(242, 205, 205, 0.07) 45%,
      rgba(116, 199, 236, 0.07) 58%,
      transparent 72%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
  }

  .hero-title {
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 9rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .hero-sub {
    font-size: clamp(0.78rem, 2vw, 0.88rem);
    color: var(--overlay1);
    letter-spacing: 0.05em;
  }

  .hero-actions {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--sp-2);
  }

  /* ── Section labels ───────────────────────────────────────────────── */
  .section-label {
    display: block;
    font-size: 0.73rem;
    color: var(--overlay1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--sp-6);
  }

  .section-intro {
    font-size: 0.95rem;
    color: var(--text);
    opacity: 0.82;
    line-height: 1.75;
    max-width: 680px;
    margin-bottom: var(--sp-8);
  }

  /* ── Bento grid ───────────────────────────────────────────────────── */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }

  .bento-featured { grid-column: 1 / 3; }
  .bento-tall     { grid-row: span 2; }

  .bento-slot {
    display: flex;
    flex-direction: column;
  }

  .bento-slot :global(.project-card) {
    flex: 1;
  }

  /* ── ZentoPath featured card ──────────────────────────────────────── */
  .featured-card {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .feat-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .feat-eyebrow {
    display: block;
    font-size: 0.70rem;
    color: var(--overlay1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--sp-2);
  }

  .feat-title {
    font-weight: 800;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    letter-spacing: -0.03em;
  }

  .feat-meta {
    font-size: 0.76rem;
    color: var(--overlay1);
    margin-top: var(--sp-1);
  }

  .feat-cta { align-self: flex-start; }

  .feat-desc {
    font-size: 0.93rem;
    line-height: 1.78;
    color: var(--text);
    opacity: 0.86;
  }

  /* ── Engineering layout ──────────────────────────────────────────── */
  .eng-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
    align-items: start;
  }

  @media (max-width: 700px) {
    .eng-grid { grid-template-columns: 1fr; }
  }

  .eng-card {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .eng-title {
    font-weight: 800;
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    letter-spacing: -0.03em;
  }

  .eng-desc {
    font-size: 0.92rem;
    line-height: 1.85;
    color: var(--text);
    opacity: 0.82;
  }

  /* ── Engineering stack card ───────────────────────────────────────── */
  .eng-stack-card {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .eng-stack-group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .eng-stack-label {
    font-size: 0.68rem;
    color: var(--overlay1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ── Axioms grid — mobile-first ───────────────────────────────────── */
  .axioms-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
  }

  @media (min-width: 640px) {
    .axioms-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .axiom-card {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .axiom-head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .axiom-num {
    font-size: 0.70rem;
    color: var(--overlay0);
    letter-spacing: 0.12em;
  }

  .axiom-title {
    font-weight: 800;
    font-size: clamp(1.2rem, 3vw, 1.45rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .axiom-mauve    { color: var(--mauve); }
  .axiom-sapphire { color: var(--sapphire); }
  .axiom-teal     { color: var(--teal); }
  .axiom-peach    { color: var(--peach); }

  .axiom-label {
    font-size: 0.73rem;
    color: var(--overlay0);
    letter-spacing: 0.05em;
  }

  .axiom-desc {
    font-size: 0.9rem;
    color: var(--text);
    opacity: 0.82;
    line-height: 1.72;
  }

  .axiom-desc :global(em) {
    font-style: normal;
    color: var(--text);
    opacity: 1;
  }

  /* ── Bento responsive ────────────────────────────────────────────── */
  @media (max-width: 860px) {
    .bento-grid             { grid-template-columns: repeat(2, 1fr); }
    .bento-featured         { grid-column: 1 / 3; }
    .bento-tall             { grid-row: auto; }
  }

  @media (max-width: 560px) {
    .bento-grid             { grid-template-columns: 1fr; }
    .bento-featured         { grid-column: 1; }
  }

  /* ── Mobile overrides ─────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero          { padding: var(--sp-16) 0; }
    .featured-card { padding: var(--sp-6); }
    .eng-card      { padding: var(--sp-6); }
    .hero-title    { letter-spacing: -0.04em; }
    .axiom-card    { padding: var(--sp-6); }
  }

  @media (max-width: 480px) {
    .featured-card,
    .eng-card   { padding: var(--sp-6) var(--sp-4); }
    .axiom-card { padding: var(--sp-4); }
    .feat-desc,
    .eng-desc   { font-size: 0.9rem; }
    .section-intro { font-size: 0.88rem; }
  }

  @media (max-width: 400px) {
    .hero         { padding: var(--sp-12) 0; }
    .hero-actions { flex-direction: column; align-items: center; }
    .hero-sub     { font-size: 0.75rem; }
  }

  /* ── Contact card ─────────────────────────────────────────────────── */
  .contact-card {
    padding: var(--sp-10);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    max-width: 640px;
  }

  .contact-title {
    font-weight: 800;
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    letter-spacing: -0.03em;
  }

  .contact-desc {
    font-size: 0.95rem;
    line-height: 1.78;
    color: var(--text);
    opacity: 0.82;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .contact-pill {
    display: inline-block;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--mauve);
    text-decoration: none;
    border: 1px solid rgba(203, 166, 247, 0.25);
    border-radius: 6px;
    padding: 0.45em 0.9em;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .contact-pill:hover {
    background: rgba(203, 166, 247, 0.08);
    border-color: rgba(203, 166, 247, 0.50);
    color: var(--text);
  }

  @media (max-width: 768px) {
    .contact-card { padding: var(--sp-6); }
  }

  @media (max-width: 480px) {
    .contact-card { padding: var(--sp-6) var(--sp-4); }
  }
</style>
