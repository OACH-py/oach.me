---
import ProjectCard from './ProjectCard.astro';
import { softwareProjectsEs, softwareProjectsEn } from '../data/projects';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

const projects = lang === 'es' ? softwareProjectsEs : softwareProjectsEn;
const [zentopath, kanso, oachme] = projects;

const t = {
  es: {
    desc:          'OACH — Ingeniería Electrónica · Defensor FOSS · Soberanía Digital',
    heroParagraph: 'Estudiante de Ingeniería Electrónica · Defensor FOSS · Soberanía Digital',
    heroBtn:       'Ver Proyectos',
    sec01:         '01 — Proyectos',
    flagship:      'Proyecto Principal',
    featMeta:      'Divulgación Técnica · YouTube',
    viewChan:      'Ver Canal ↗',
    sec02:         '02 — Documentación de Ingeniería',
    engTitle:      'Ingeniería Electrónica',
    engP1: `Mi interés central en Ingeniería Electrónica reside en la convergencia entre el código
abstracto y el hardware tangible. Me enfoco en cómo las líneas de instrucción interactúan
directamente con el silicio para producir efectos medibles en el mundo físico — desde el
control de procesos industriales hasta el diseño de sistemas embebidos.`,
    engP2: `Actualmente cursando el 2do semestre de Ingeniería Electrónica en el Tecnológico de la Laguna, con especialización en`,
    engSpec: 'Control & Automatización',
    engP2tail: `. Mi base técnica comienza como Técnico en Ofimática — punto de partida desde el que migré hacia la intersección entre el código abstracto y el silicio.`,
    sec03:    '03 — Filosofía del Sistema',
    philoIntro: `Adoptar la filosofía`,
    philoAnd: 'y',
    philoTail: `refleja una necesidad de claridad sistémica y control total sobre el entorno computacional. Como buen usuario de la distro, me veo en la necesidad de mencionarlo: I use Arch, btw.
Cada decisión de flujo de trabajo está gobernada por cuatro axiomas fundamentales.`,
    axioms: [
      { num: '01', title: 'KISS',                    color: 'mauve',    label: 'Mantén la Simplicidad',    desc: 'La simpleza funcional es la prioridad. La complejidad innecesaria es un <em>error de diseño</em>.' },
      { num: '02', title: 'Privacidad<br />Proactiva',color: 'sapphire', label: 'Soberanía de Datos',       desc: 'Integridad de datos absoluta. El seguimiento, reventa y cruce de información personal es rechazado — <em>la soberanía reside en el usuario</em>.' },
      { num: '03', title: 'Transparencia<br />Técnica',color: 'teal',   label: 'Honestidad del Sistema',   desc: 'El software debe ser explícito en sus acciones y libre de <em>telemetría oculta</em>. Los procesos son observables y auditables.' },
      { num: '04', title: 'Modularidad<br />Sostenible',color: 'peach', label: 'Diseñado para el Intercambio', desc: 'Componentes intercambiables por elección del usuario, resistiendo activamente la <em>obsolescencia programada</em> mediante diseño modular.' },
    ],
  },
  en: {
    desc:          'OACH — Electronics Engineering · FOSS Advocate · Digital Sovereignty',
    heroParagraph: 'Electronics Engineering Student · FOSS Advocate · Digital Sovereignty',
    heroBtn:       'View Projects',
    sec01:         '01 — Projects',
    flagship:      'Flagship Project',
    featMeta:      'Technical Outreach · YouTube',
    viewChan:      'View Channel ↗',
    sec02:         '02 — Engineering Documentation',
    engTitle:      'Electronics Engineering',
    engP1: `My core interest in Electronics Engineering lies at the convergence of abstract
code and tangible hardware. I focus on how lines of instruction interact directly
with silicon to produce measurable effects in the physical world — from industrial
process control to embedded systems design.`,
    engP2: `Currently in my 2nd semester of Electronics Engineering at Tecnológico de la Laguna, specializing in`,
    engSpec: 'Control & Automation',
    engP2tail: `. My technical foundation began as an Ofimática Technician — the starting point from which I migrated toward the intersection of abstract code and silicon.`,
    sec03:    '03 — System Philosophy',
    philoIntro: `Adopting the`,
    philoAnd: 'philosophy and',
    philoTail: `reflects a need for systemic clarity and full control over the computational environment. As a proper user of the distro, I feel compelled to mention it: I use Arch, btw.
Every workflow decision is governed by four foundational axioms.`,
    axioms: [
      { num: '01', title: 'KISS',                      color: 'mauve',    label: 'Keep It Simple, Stupid', desc: 'Functional simplicity is the priority. Unnecessary complexity is a <em>design error</em>.' },
      { num: '02', title: 'Proactive<br />Privacy',     color: 'sapphire', label: 'Data Sovereignty',      desc: 'Absolute data integrity. Tracking, resale, and cross-referencing of personal information is rejected — <em>sovereignty rests with the user</em>.' },
      { num: '03', title: 'Technical<br />Transparency',color: 'teal',    label: 'System Honesty',         desc: 'Software must be explicit in its actions and free of <em>hidden telemetry</em>. Processes are observable and auditable.' },
      { num: '04', title: 'Sustainable<br />Modularity',color: 'peach',   label: 'Swappable by Design',   desc: 'Components swappable by user choice, actively resisting <em>planned obsolescence</em> through modular design.' },
    ],
  },
};

const tx = t[lang];
---

<!-- HERO -->
<section id="hero" class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-inner">

    <h1 class="hero-title shimmer-text">OACH</h1>

    <p class="hero-sub">{tx.heroParagraph}</p>

    <div class="hero-actions">
      <a href="#zento" class="btn btn-primary">{tx.heroBtn}</a>
      <a href="https://github.com/OACH-py" class="btn btn-ghost" target="_blank" rel="noopener">GitHub ↗</a>
      <a href="https://youtube.com/@ZentoPath" class="btn btn-ghost" target="_blank" rel="noopener">ZentoPath ↗</a>
    </div>

  </div>
</section>

<!-- PROJECTS -->
<section id="zento" class="section container">

  <span class="section-label" data-reveal>{tx.sec01}</span>

  <div class="glass glass-featured tilt-card featured-card" data-reveal style="--reveal-delay: 0.05s">
    <div class="feat-header">
      <div class="feat-identity">
        <div>
          <span class="feat-eyebrow">{tx.flagship}</span>
          <h2 class="feat-title grad-text-hero">ZentoPath</h2>
          <p class="feat-meta">{tx.featMeta}</p>
        </div>
      </div>
      <a href="https://youtube.com/@ZentoPath" class="btn btn-primary feat-cta" target="_blank" rel="noopener">
        {tx.viewChan}
      </a>
    </div>

    <p class="feat-desc">{zentopath.description}</p>

    <div class="tags">
      {zentopath.tags.map(t => <span class="tag tag-sapphire">{t}</span>)}
    </div>
  </div>

  <div class="project-row" data-reveal style="--reveal-delay: 0.12s">
    <ProjectCard project={kanso} lang={lang} />
    <ProjectCard project={oachme} lang={lang} />
  </div>

</section>

<hr class="divider container" />

<!-- ENGINEERING -->
<section id="notes" class="section container">

  <span class="section-label" data-reveal>{tx.sec02}</span>

  <div class="glass eng-card" data-reveal style="--reveal-delay: 0.08s">
    <h2 class="eng-title grad-text-hero">{tx.engTitle}</h2>
    <p class="eng-desc">{tx.engP1}</p>
    <p class="eng-desc">
      {tx.engP2}
      <strong class="accent-teal">{tx.engSpec}</strong>{tx.engP2tail}
    </p>
  </div>


</section>

<hr class="divider container" />

<!-- PHILOSOPHY -->
<section id="filosofia" class="section container">

  <span class="section-label" data-reveal>{tx.sec03}</span>

  <p class="section-intro" data-reveal style="--reveal-delay: 0.06s">
    {tx.philoIntro}
    <strong class="accent-mauve">Suckless</strong> {tx.philoAnd}
    <strong class="accent-sapphire">Arch Linux</strong>
    {tx.philoTail}
  </p>

  <div class="axioms-grid">
    {tx.axioms.map((a, i) => (
      <div class="glass tilt-card axiom-card" data-reveal style={`--reveal-delay: ${0.05 + i * 0.07}s`}>
        <div class="axiom-head">
          <span class="axiom-num">{a.num}</span>
          <h3 class={`axiom-title axiom-${a.color}`} set:html={a.title} />
        </div>
        <p class="axiom-label">{a.label}</p>
        <p class="axiom-desc" set:html={a.desc} />
      </div>
    ))}
  </div>

</section>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding: var(--sp-24) 0 var(--sp-20);
    overflow: hidden;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -62%);
    width: 1000px; height: 700px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      rgba(203, 166, 247, 0.22) 0%,
      rgba(245, 194, 231, 0.10) 28%,
      rgba(242, 205, 205, 0.07) 45%,
      rgba(116, 199, 236, 0.07) 58%,
      transparent 72%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
  }

  .hero-title {
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 9rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .hero-sub {
    font-size: 0.88rem;
    color: var(--overlay1);
    letter-spacing: 0.05em;
  }

  .hero-actions {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--sp-2);
  }

  /* ── Section labels ───────────────────────────────────────────────── */
  .section-label {
    display: block;
    font-size: 0.73rem;
    color: var(--overlay1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--sp-6);
  }

  .section-intro {
    font-size: 0.95rem;
    color: var(--text);
    opacity: 0.82;
    line-height: 1.75;
    max-width: 680px;
    margin-bottom: var(--sp-8);
  }

  /* ── ZentoPath featured card ──────────────────────────────────────── */
  .featured-card {
    padding: var(--sp-10);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .feat-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-6);
    flex-wrap: wrap;
  }

  .feat-identity {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
  }

  .feat-eyebrow {
    display: block;
    font-size: 0.70rem;
    color: var(--overlay1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--sp-2);
  }

  .feat-title {
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3.2rem);
    letter-spacing: -0.03em;
  }

  .feat-meta {
    font-size: 0.76rem;
    color: var(--overlay1);
    margin-top: var(--sp-1);
  }

  .feat-cta { align-self: flex-start; }

  .feat-desc {
    font-size: 0.97rem;
    line-height: 1.78;
    color: var(--text);
    opacity: 0.86;
    max-width: 700px;
  }

  /* ── Project row ──────────────────────────────────────────────────── */
  .project-row {
    margin-top: var(--sp-6);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  }

  /* ── Engineering card ─────────────────────────────────────────────── */
  .eng-card {
    padding: var(--sp-10);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .eng-title {
    font-weight: 800;
    font-size: 1.85rem;
    letter-spacing: -0.03em;
  }

  .eng-desc {
    font-size: 0.95rem;
    line-height: 1.78;
    color: var(--text);
    opacity: 0.82;
    max-width: 700px;
  }

  /* ── Axioms grid ──────────────────────────────────────────────────── */
  .axioms-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-6);
  }

  .axiom-card {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .axiom-head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .axiom-num {
    font-size: 0.70rem;
    color: var(--overlay0);
    letter-spacing: 0.12em;
  }

  .axiom-title {
    font-weight: 800;
    font-size: 1.45rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .axiom-mauve    { color: var(--mauve); }
  .axiom-sapphire { color: var(--sapphire); }
  .axiom-teal     { color: var(--teal); }
  .axiom-peach    { color: var(--peach); }

  .axiom-label {
    font-size: 0.73rem;
    color: var(--overlay0);
    letter-spacing: 0.05em;
  }

  .axiom-desc {
    font-size: 0.9rem;
    color: var(--text);
    opacity: 0.82;
    line-height: 1.72;
  }

  .axiom-desc :global(em) {
    font-style: normal;
    color: var(--text);
    opacity: 1;
  }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero          { padding: var(--sp-16) 0; }
    .axioms-grid   { grid-template-columns: 1fr; }
    .featured-card { padding: var(--sp-6); }
    .eng-card      { padding: var(--sp-6); }
    .hero-title    { letter-spacing: -0.04em; }
  }
</style>
