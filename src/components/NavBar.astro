---
const pathname = Astro.url.pathname;
const lang = pathname.startsWith('/en') ? 'en' : pathname.startsWith('/ru') ? 'ru' : 'es';

const menuLabel = lang === 'ru' ? 'Меню' : lang === 'en' ? 'Menu' : 'Menú';

const navLinksEs = [
  { href: '#zento',     label: 'Proyectos'  },
  { href: '#notes',     label: 'Ingeniería' },
  { href: '#filosofia', label: 'Filosofía'  },
  { href: '#contact',   label: 'Contacto'   },
];

const navLinksEn = [
  { href: '#zento',     label: 'Projects'    },
  { href: '#notes',     label: 'Engineering' },
  { href: '#filosofia', label: 'Philosophy'  },
  { href: '#contact',   label: 'Contact'     },
];

const navLinksRu = [
  { href: '#zento',     label: 'Проекты'        },
  { href: '#notes',     label: 'Инженерия'       },
  { href: '#filosofia', label: 'Философия'       },
  { href: '#contact',   label: 'Контакт'         },
];

const navLinks = lang === 'ru' ? navLinksRu : lang === 'en' ? navLinksEn : navLinksEs;

const langOptions = [
  { code: 'es', label: 'ES', href: '/'    },
  { code: 'en', label: 'EN', href: '/en/' },
  { code: 'ru', label: 'RU', href: '/ru/' },
];

const homeHref = langOptions.find(l => l.code === lang)!.href;
---
<header class="site-header" id="site-header">
  <nav class="container nav-inner" aria-label="Navegación principal">

    <a href={homeHref} class="nav-logo" aria-label="Inicio — OACH">
      <img src="/favicon.svg" alt="OACH" class="nav-logo-img" width="36" height="36" />
    </a>

    <ul class="nav-links" id="nav-menu" role="list">
      {navLinks.map(link => (
        <li><a href={link.href} class="nav-link">{link.label}</a></li>
      ))}
    </ul>

    <div class="nav-right">
      <a
        href="https://github.com/OACH-py"
        class="nav-gh"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub — OACH-py"
      >GitHub ↗</a>
      <div class="lang-group" role="navigation" aria-label="Language / Idioma / Язык">
        {langOptions.map(l => (
          l.code === lang
            ? <span class="lang-badge lang-active" aria-current="true">{l.label}</span>
            : <a href={l.href} class="lang-badge">{l.label}</a>
        ))}
      </div>
      <button
        class="nav-burger"
        id="nav-burger"
        aria-label={menuLabel}
        aria-expanded="false"
        aria-controls="nav-menu"
        type="button"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: rgba(17, 17, 27, 0.82);
    border-bottom: 1px solid rgba(203, 166, 247, 0.09);
    transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-header.nav-hidden { transform: translateY(-110%); }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .nav-logo:hover { opacity: 0.75; }

  .nav-logo-img {
    display: block;
    width: 36px;
    height: 36px;
  }

  /* Desktop: centred inline links */
  .nav-links {
    display: flex;
    gap: var(--sp-6);
    list-style: none;
    margin: 0 auto;
  }

  .nav-link {
    font-size: 0.83rem;
    color: var(--overlay1);
    text-decoration: none;
    transition: color 0.2s ease;
    letter-spacing: 0.01em;
    padding: var(--sp-1) 0;
  }

  .nav-link:hover { color: var(--mauve); }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-shrink: 0;
  }

  .nav-gh {
    font-size: 0.78rem;
    color: var(--overlay1);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-gh:hover { color: var(--sapphire); }

  .lang-group {
    display: flex;
    align-items: center;
    gap: 0.25em;
    border: 1px solid rgba(203, 166, 247, 0.18);
    border-radius: 999px;
    padding: 0.12em 0.45em;
    background: rgba(203, 166, 247, 0.04);
  }

  .lang-badge {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    color: var(--overlay0);
    text-decoration: none;
    padding: 0.12em 0.38em;
    border-radius: 999px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .lang-badge:hover {
    color: var(--mauve);
    background: rgba(203, 166, 247, 0.10);
  }

  .lang-active {
    color: var(--mauve);
    background: rgba(203, 166, 247, 0.13);
    cursor: default;
  }

  /* ── Hamburger button ────────────────────────────────────────────── */
  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    transition: background 0.2s ease;
  }

  .nav-burger:hover { background: rgba(203, 166, 247, 0.08); }

  .nav-burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--overlay1);
    border-radius: 2px;
    transform-origin: center;
    transition: transform 0.22s ease, opacity 0.22s ease, background 0.2s ease;
  }

  .nav-burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .nav-burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .nav-burger[aria-expanded="true"] span { background: var(--mauve); }

  /* ── Mobile layout ───────────────────────────────────────────────── */
  @media (max-width: 580px) {
    .nav-burger { display: flex; }
    .nav-gh     { display: none; }

    .nav-links {
      display: none;
      position: fixed;
      top: var(--nav-height);
      left: 0; right: 0;
      flex-direction: column;
      gap: 0;
      margin: 0;
      background: rgba(17, 17, 27, 0.97);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-bottom: 1px solid rgba(203, 166, 247, 0.10);
      padding: var(--sp-4) var(--sp-6) var(--sp-6);
      z-index: 99;
    }

    .nav-links.is-open { display: flex; }

    .nav-link {
      font-size: 1rem;
      padding: var(--sp-4) 0;
      border-bottom: 1px solid rgba(203, 166, 247, 0.06);
      display: block;
    }

    .nav-links li:last-child .nav-link { border-bottom: none; }
  }
</style>

<script>
  /* ── Scroll-hide behaviour ─────────────────────────────────────────── */
  const header = document.getElementById('site-header')!;
  let lastY   = window.scrollY;
  let ticking = false;

  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      if (y > 80) {
        header.classList.toggle('nav-hidden', y > lastY);
      } else {
        header.classList.remove('nav-hidden');
      }
      lastY   = y;
      ticking = false;
    });
  }, { passive: true });

  /* ── Hamburger menu ────────────────────────────────────────────────── */
  const burger = document.getElementById('nav-burger') as HTMLButtonElement | null;
  const menu   = document.getElementById('nav-menu')   as HTMLElement | null;

  if (burger && menu) {
    burger.addEventListener('click', () => {
      const open = menu.classList.toggle('is-open');
      burger.setAttribute('aria-expanded', String(open));
      header.classList.remove('nav-hidden');
    });

    menu.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.remove('is-open');
        burger.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) {
        menu.classList.remove('is-open');
        burger.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
