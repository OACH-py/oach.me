---
const pathname = Astro.url.pathname;
const lang = pathname.startsWith('/en') ? 'en' : 'es';
const homeHref  = lang === 'es' ? '/' : '/en/';
const otherHref = lang === 'es' ? '/en/' : '/';
const otherLabel = lang === 'es' ? 'EN' : 'ES';

const navLinksEs = [
  { href: '#zento',     label: 'Proyectos'  },
  { href: '#notes',     label: 'Ingeniería' },
  { href: '#filosofia', label: 'Filosofía'  },
];

const navLinksEn = [
  { href: '#zento',     label: 'Projects'    },
  { href: '#notes',     label: 'Engineering' },
  { href: '#filosofia', label: 'Philosophy'  },
];

const navLinks = lang === 'es' ? navLinksEs : navLinksEn;
---
<header class="site-header" id="site-header">
  <nav class="container nav-inner">

    <a href={homeHref} class="nav-logo" aria-label="Inicio — OACH">
      <span class="nav-wordmark">OACH</span>
    </a>

    <ul class="nav-links">
      {navLinks.map(link => (
        <li><a href={link.href} class="nav-link">{link.label}</a></li>
      ))}
    </ul>

    <div class="nav-right">
      <a
        href="https://github.com/OACH-py"
        class="nav-gh"
        target="_blank"
        rel="noopener"
      >GitHub ↗</a>
      <a href={otherHref} class="lang-toggle" aria-label="Switch language">
        {otherLabel}
      </a>
    </div>

  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: rgba(17, 17, 27, 0.82);
    border-bottom: 1px solid rgba(203, 166, 247, 0.09);
    transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-header.nav-hidden { transform: translateY(-110%); }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .nav-logo:hover { opacity: 0.75; }

  .nav-wordmark {
    font-size: 0.85rem;
    font-weight: 600;
    background: linear-gradient(90deg, var(--mauve), var(--sapphire));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0.06em;
  }

  .nav-links {
    display: flex;
    gap: var(--sp-6);
    list-style: none;
    margin: 0 auto;
  }

  .nav-link {
    font-size: 0.83rem;
    color: var(--overlay1);
    text-decoration: none;
    transition: color 0.2s ease;
    letter-spacing: 0.01em;
  }

  .nav-link:hover { color: var(--mauve); }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-shrink: 0;
  }

  .nav-gh {
    font-size: 0.78rem;
    color: var(--overlay1);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-gh:hover { color: var(--sapphire); }

  .lang-toggle {
    font-size: 0.70rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--overlay1);
    text-decoration: none;
    border: 1px solid rgba(203, 166, 247, 0.28);
    padding: 0.22em 0.75em;
    border-radius: 999px;
    background: rgba(203, 166, 247, 0.06);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .lang-toggle:hover {
    color: var(--mauve);
    border-color: rgba(203, 166, 247, 0.55);
    background: rgba(203, 166, 247, 0.14);
    box-shadow: 0 0 16px rgba(203, 166, 247, 0.12);
  }

  @media (max-width: 540px) {
    .nav-links { gap: var(--sp-3); }
    .nav-link  { font-size: 0.76rem; }
    .nav-gh    { display: none; }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  let lastY = window.scrollY;
  let ticking = false;

  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      if (y > 80) {
        header.classList.toggle('nav-hidden', y > lastY);
      } else {
        header.classList.remove('nav-hidden');
      }
      lastY = y;
      ticking = false;
    });
  }, { passive: true });
</script>
