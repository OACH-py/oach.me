---
import type { Project } from '../data/projects';

interface Props {
  project: Project & { stars?: number };
  lang?: 'es' | 'en' | 'ru';
}

const { project, lang = 'es' } = Astro.props;

const statusLabels = {
  es: { active: 'En desarrollo', planned: 'Próximamente', complete: 'Completo'  },
  en: { active: 'Active',        planned: 'Coming soon',  complete: 'Complete'  },
  ru: { active: 'Активный',      planned: 'Скоро',        complete: 'Завершён'  },
};

const ctaLabel = { es: 'Ver proyecto ↗', en: 'View project ↗', ru: 'Открыть ↗' };

const statusLabel = statusLabels[lang][project.status];
---
<article class:list={['glass tilt-card project-card', `accent-${project.accent}`]}>
  <div class="card-header">
    <div>
      <h3 class="card-title">{project.title}</h3>
      <p class="card-subtitle">{project.subtitle}</p>
    </div>
    <div class="card-badges">
      {project.stars != null && project.stars > 0 && (
        <span class="star-badge">★ {project.stars}</span>
      )}
      <span class:list={['tag status-tag', `tag-${project.accent}`]}>
        {statusLabel}
      </span>
    </div>
  </div>

  <p class="card-desc">{project.description}</p>

  <div class="tags">
    {(project.tags ?? []).map(t => (
      <span class:list={['tag', `tag-${project.accent}`]}>{t}</span>
    ))}
  </div>

  {project.link && (
    <a href={project.link} class="btn btn-primary card-cta" target="_blank" rel="noopener noreferrer">
      {ctaLabel[lang]}
    </a>
  )}
</article>

<style>
  .project-card {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-4);
  }

  .card-title {
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .card-subtitle {
    font-size: 0.8rem;
    color: var(--overlay2);
    margin-top: var(--sp-1);
  }

  .card-badges {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--sp-2);
    flex-shrink: 0;
  }

  .star-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--yellow);
    background: rgba(249, 226, 175, 0.10);
    border: 1px solid rgba(249, 226, 175, 0.25);
    border-radius: 999px;
    padding: 0.15em 0.6em;
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  .status-tag { font-size: 0.68rem; white-space: nowrap; }

  .card-desc {
    font-size: 0.95rem;
    color: var(--text);
    opacity: 0.85;
    line-height: 1.7;
  }

  .card-cta {
    align-self: flex-start;
    margin-top: auto;
  }
</style>

<script>
  function initTilt() {
    document.querySelectorAll<HTMLElement>('.tilt-card').forEach(card => {
      let raf = 0;

      card.addEventListener('mouseenter', () => {
        card.style.transition = 'transform 0.08s ease, box-shadow 0.3s ease';
      });

      card.addEventListener('mousemove', (e: MouseEvent) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r  = card.getBoundingClientRect();
          const x  = e.clientX - r.left;
          const y  = e.clientY - r.top;
          const cx = r.width  / 2;
          const cy = r.height / 2;
          const tX = ((y - cy) / cy) * -7;
          const tY = ((x - cx) / cx) *  7;
          card.style.transform =
            `perspective(900px) rotateX(${tX}deg) rotateY(${tY}deg) scale3d(1.02,1.02,1.02)`;
        });
      });

      card.addEventListener('mouseleave', () => {
        cancelAnimationFrame(raf);
        card.style.transition =
          'transform 0.55s cubic-bezier(0.23,1,0.32,1), box-shadow 0.3s ease';
        card.style.transform =
          'perspective(900px) rotateX(0deg) rotateY(0deg) scale3d(1,1,1)';
      });
    });
  }

  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    initTilt();
  }
</script>
